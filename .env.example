SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true

# 发件邮箱（建议使用 QQ 邮箱）
ALERT_EMAIL_USER=2895845213@qq.com

# 邮箱授权码（不是邮箱登录密码）
ALERT_EMAIL_PASS=uhfqbofpcjmbdeij

# 发件人显示，可直接与 ALERT_EMAIL_USER 一致
ALERT_EMAIL_FROM=2895845213@qq.com

# 默认接收人已按你的需求写好，可按需改
ALERT_EMAIL_TO=2895845213@qq.com

# true/false，是否开启邮件提醒
ALERT_EMAIL_ENABLED=true

# 登录等待超时时间（毫秒），默认 900000=15分钟
LOGIN_WAIT_TIMEOUT_MS=900000

# 未登录时邮件重发间隔（毫秒），默认 60000=1分钟
LOGIN_REMIND_INTERVAL_MS=60000

# 短信验证页邮件重发间隔（秒），默认 300=5 分钟；兼容旧变量 SMS_REMIND_INTERVAL_MS（毫秒）
SMS_REMIND_INTERVAL_SEC=300

# 登录验证方式：
# - qr: 二维码/原流程
# - sms: 发送短信验证
# - receive_sms_code: 接收短信验证码，并从邮箱回复中自动读取验证码回填
LOGIN_VERIFY_METHOD=qr

# sms 模式下点击“我已发送”的间隔（秒）；兼容旧变量 SMS_SENT_CLICK_INTERVAL_MS(毫秒)
SMS_SENT_CLICK_INTERVAL_SEC=1

# receive_sms_code 模式：收件箱配置（默认复用 SMTP_* / ALERT_EMAIL_*）
OTP_IMAP_HOST=
OTP_IMAP_PORT=993
OTP_IMAP_SECURE=true
OTP_IMAP_USER=
OTP_IMAP_PASS=
OTP_IMAP_MAILBOX=INBOX

# 回复邮件主题前缀（系统会拼接账号名）
OTP_REPLY_SUBJECT_PREFIX=[抖音验证码回复]

# 可选：限制验证码回复发件人包含此字符串（如某个邮箱）
OTP_REPLY_FROM_INCLUDES=

# 拉取验证码邮件频率（秒）和可接受邮件最大时效（秒）
OTP_EMAIL_POLL_INTERVAL_SEC=5
OTP_EMAIL_MAX_AGE_SEC=600

# receive_sms_code 模式下，页面点击“重新发送”的间隔（秒）；默认 300=5 分钟
OTP_RESEND_INTERVAL_SEC=300

# ========== 抖店登录（scripts/douyin-shop） ==========
# 抖店登录页（通常不需要改）
SHOP_LOGIN_URL=https://fxg.jinritemai.com/login/common?channel=zhaoshang
# 登录成功后期望的 home 页
SHOP_HOME_URL=https://fxg.jinritemai.com/ffa/mshop/homepage

# 默认账号（单个）
SHOP_EMAIL=lianou_rpa2@163.com
SHOP_PASSWORD=Lianou123

# 或以 JSON 数组配置多账号，优先级高于 SHOP_EMAIL/SHOP_PASSWORD：
# SHOP_ACCOUNTS_JSON=[{"email":"a@b.com","password":"xxx"},{"email":"c@d.com","password":"yyy"}]

# 账号登录态保存目录（默认 accounts-shop）
SHOP_ACCOUNTS_DIR=accounts-shop

# 滑块拖动总时长（毫秒），越小越快但越容易被识别为机器
SHOP_SLIDER_DURATION_MS=900
# 每次登录滑块最多重试次数（失败后刷新并重试）
SHOP_SLIDER_MAX_RETRY=5
# 整个登录等待的超时时间（毫秒），包括人工接管的时间
SHOP_LOGIN_TIMEOUT_MS=120000
